<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ITServiceRequest" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude" exporterVersion="1.0">
  <bpmn:process id="Process_ITServiceRequest" name="IT Service Request" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Employee Reports IT Problem">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SubmitRequest" name="Submit IT Support Request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RegisterRequest" name="Register Request">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckSeverity" name="Check Severity of the Problem">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Severity" name="Severity Level?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5_Low</bpmn:outgoing>
      <bpmn:outgoing>Flow_6_High</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AssignSupport" name="Assign to Support Technician">
      <bpmn:incoming>Flow_5_Low</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssignSenior" name="Assign to Senior Technician">
      <bpmn:incoming>Flow_6_High</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SeverityMerge">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Investigate" name="Investigate the Problem">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Resolvable" name="Resolvable Internally?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_12_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FixProblem" name="Fix the Problem">
      <bpmn:incoming>Flow_11_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Escalate" name="Escalate to External Service Provider">
      <bpmn:incoming>Flow_12_No</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ResolvableMerge">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_UpdateStatus" name="Update Request Status">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NotifyEmployee" name="Send Resolution Notification">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Request Resolved">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitRequest" targetRef="Task_RegisterRequest" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_RegisterRequest" targetRef="Task_CheckSeverity" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckSeverity" targetRef="Gateway_Severity" />
    <bpmn:sequenceFlow id="Flow_5_Low" name="Low" sourceRef="Gateway_Severity" targetRef="Task_AssignSupport" />
    <bpmn:sequenceFlow id="Flow_6_High" name="High" sourceRef="Gateway_Severity" targetRef="Task_AssignSenior" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_AssignSupport" targetRef="Gateway_SeverityMerge" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_AssignSenior" targetRef="Gateway_SeverityMerge" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_SeverityMerge" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Investigate" targetRef="Gateway_Resolvable" />
    <bpmn:sequenceFlow id="Flow_11_Yes" name="Yes" sourceRef="Gateway_Resolvable" targetRef="Task_FixProblem" />
    <bpmn:sequenceFlow id="Flow_12_No" name="No" sourceRef="Gateway_Resolvable" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_FixProblem" targetRef="Gateway_ResolvableMerge" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Escalate" targetRef="Gateway_ResolvableMerge" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_ResolvableMerge" targetRef="Task_UpdateStatus" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_UpdateStatus" targetRef="Task_NotifyEmployee" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_NotifyEmployee" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ITServiceRequest">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="130" y="225" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitRequest_di" bpmnElement="Task_SubmitRequest">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegisterRequest_di" bpmnElement="Task_RegisterRequest">
        <dc:Bounds x="390" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckSeverity_di" bpmnElement="Task_CheckSeverity">
        <dc:Bounds x="540" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Severity_di" bpmnElement="Gateway_Severity" isMarkerVisible="true">
        <dc:Bounds x="690" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="668" y="232" width="94" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignSupport_di" bpmnElement="Task_AssignSupport">
        <dc:Bounds x="790" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignSenior_di" bpmnElement="Task_AssignSenior">
        <dc:Bounds x="790" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SeverityMerge_di" bpmnElement="Gateway_SeverityMerge" isMarkerVisible="true">
        <dc:Bounds x="940" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Investigate_di" bpmnElement="Task_Investigate">
        <dc:Bounds x="1020" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Resolvable_di" bpmnElement="Gateway_Resolvable" isMarkerVisible="true">
        <dc:Bounds x="1170" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1148" y="232" width="94" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FixProblem_di" bpmnElement="Task_FixProblem">
        <dc:Bounds x="1270" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate">
        <dc:Bounds x="1270" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ResolvableMerge_di" bpmnElement="Gateway_ResolvableMerge" isMarkerVisible="true">
        <dc:Bounds x="1420" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateStatus_di" bpmnElement="Task_UpdateStatus">
        <dc:Bounds x="1500" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyEmployee_di" bpmnElement="Task_NotifyEmployee">
        <dc:Bounds x="1650" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1800" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1780" y="225" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="200" /><di:waypoint x="390" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="490" y="200" /><di:waypoint x="540" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="640" y="200" /><di:waypoint x="690" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_Low_di" bpmnElement="Flow_5_Low">
        <di:waypoint x="715" y="175" /><di:waypoint x="715" y="80" /><di:waypoint x="790" y="80" />
        <bpmndi:BPMNLabel><dc:Bounds x="721" y="125" width="24" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_High_di" bpmnElement="Flow_6_High">
        <di:waypoint x="715" y="225" /><di:waypoint x="715" y="360" /><di:waypoint x="790" y="360" />
        <bpmndi:BPMNLabel><dc:Bounds x="721" y="290" width="28" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="890" y="80" /><di:waypoint x="965" y="80" /><di:waypoint x="965" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="890" y="360" /><di:waypoint x="965" y="360" /><di:waypoint x="965" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="990" y="200" /><di:waypoint x="1020" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1120" y="200" /><di:waypoint x="1170" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_Yes_di" bpmnElement="Flow_11_Yes">
        <di:waypoint x="1195" y="175" /><di:waypoint x="1195" y="80" /><di:waypoint x="1270" y="80" />
        <bpmndi:BPMNLabel><dc:Bounds x="1201" y="125" width="24" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_No_di" bpmnElement="Flow_12_No">
        <di:waypoint x="1195" y="225" /><di:waypoint x="1195" y="360" /><di:waypoint x="1270" y="360" />
        <bpmndi:BPMNLabel><dc:Bounds x="1201" y="290" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1370" y="80" /><di:waypoint x="1445" y="80" /><di:waypoint x="1445" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1370" y="360" /><di:waypoint x="1445" y="360" /><di:waypoint x="1445" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="1470" y="200" /><di:waypoint x="1500" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="1600" y="200" /><di:waypoint x="1650" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="1750" y="200" /><di:waypoint x="1800" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>